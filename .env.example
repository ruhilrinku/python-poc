# Application
APP_NAME=Employee Management API
APP_VERSION=1.0.0
DEBUG=false

# Database identity
DB_NAME=postgres
DB_SCHEMA=employee_management

# Database (SQLAlchemy / app runtime)
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/postgres?sslmode=disable
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Database (Liquibase / JDBC)
JDBC_URL=jdbc:postgresql://localhost:5432/postgres
DB_USER=postgres
DB_PASSWORD=password
LIQUIBASE_CHANGELOG=db-migrations/changelog-master.yaml
RUN_MIGRATIONS_ON_STARTUP=true
FAIL_ON_MIGRATION_ERROR=false
# Optional: set if Java is not auto-detected (Liquibase needs a JDK/JRE)
# JAVA_HOME=C:\Program Files\Java\jdk-17

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
