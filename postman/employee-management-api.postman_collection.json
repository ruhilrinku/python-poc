  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Liveness probe. Returns {\"status\": \"ok\"}."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "Create employee",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_code\": \"EMP001\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+1-555-0100\",\n  \"department_ids\": [1]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "employees"]
            },
            "description": "Create a new employee. Returns 201 with the created employee."
          },
          "response": []
        },
        {
          "name": "Get employee by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "employees", "{{employeeId}}"]
            },
            "description": "Fetch a single employee by id."
          },
          "response": []
        },
        {
          "name": "Update employee",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Johnny\",\n  \"last_name\": \"Doe\",\n  \"email\": \"johnny.doe@example.com\",\n  \"phone\": \"+1-555-0101\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "employees", "{{employeeId}}"]
            },
            "description": "Update an employee's details. All fields are optional."
          },
          "response": []
        },
        {
          "name": "Update employee departments",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"department_ids\": [2, 3]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees/{{employeeId}}/departments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "employees", "{{employeeId}}", "departments"]
            },
            "description": "Replace the set of departments an employee belongs to."
          },
          "response": []
        },
        {
          "name": "Delete employee",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "employees", "{{employeeId}}"]
            },
            "description": "Delete an employee. Returns 204 No Content."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Departments",
      "item": [
        {
          "name": "Get department employees",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/departments/{{departmentId}}/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "departments", "{{departmentId}}", "employees"]
            },
            "description": "List all employees belonging to a department."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
